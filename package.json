{
  "name": "animesh",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.5.2",
  "description": "A high-performance desktop anime streaming and downloading client built with Tauri v2, featuring magnet link aggregation search, BitTorrent stream playback, and embedded MKV subtitle extraction and rendering.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode web",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android:apk": "tauri android build --apk --target aarch64",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p animesh_core -- --test-threads=1",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml -p animesh_core --fail-under-lines 95 --fail-under-functions 95  --fail-under-regions 95 --ignore-filename-regex \"torrent_manager|src/subtitles\\.rs|infrastructure\" --no-clean -- --test-threads=1",
    "check:apply": "biome check --write --no-errors-on-unmatched",
    "check:error-handling": "tsx scripts/check-error-handling.ts",
    "check:application-params": "tsx scripts/check-application-params.ts",
    "check:interface-methods": "tsx scripts/check-interface-methods.ts",
    "check:presentation-tauri-imports": "tsx scripts/check-presentation-tauri-imports.ts",
    "check:presentation-styles": "tsx scripts/check-presentation-styles.ts",
    "check:function-length": "tsx scripts/check-function-length.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "bump-version": "tsx scripts/bump-version.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "@videojs/react": "10.0.0-beta.25",
    "ajanuw-context": "^1.0.0",
    "ajanuw-duration": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.21.0",
    "mpegts.js": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxc-parser": "^0.143.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
